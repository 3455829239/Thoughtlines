# 填写本地 server/.env，保留此文件中的占位值。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# 使用主办方的 OpenAI 兼容 API 时，填入文档提供的完整 API 前缀。
# OPENAI_BASE_URL=

# 旧版兼容服务配置，在 OPENAI_API_KEY 为空时使用。
# LLM_API_KEY=
# LLM_MODEL=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_JSON_MODE=true
# LLM_TOKEN_PARAM=max_tokens
# LLM_TIMEOUT_MS=90000
# PORT=4173
# THOUGHT_RADAR_DATA=./data/workspace.json
